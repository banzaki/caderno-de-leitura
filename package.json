{
  "name": "caderno-de-leitura",
  "version": "0.1.0",
  "private": true,
  "description": "Local reading notebook: books, daily pages, a 25 pages/day goal, notes, and a PDF/EPUB reader whose highlights become notes.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js --open",
    "dev": "node server.js",
    "test": "node --test --test-reporter=spec",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438"
  }
}
